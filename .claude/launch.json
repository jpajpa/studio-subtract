{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-v3",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3003"
      ],
      "port": 3003
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "npm run build && npm run start -- -p 3004"
      ],
      "port": 3004
    }
  ]
}
